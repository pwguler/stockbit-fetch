# Stockbit API access token (auto-managed by scripts/fetch/sb_refresh.py)
# Seed once via: python scripts/fetch/sb_refresh.py --seed-refresh '<refresh_jwt>'
BEARER_TOKEN=

# MongoDB
MONGO_URI=mongodb://user:pass@localhost:27017/
DB_NAME=stockbit

# Optional Telegram notifications (run-daily.sh / send-notification.py)
# Leave empty to disable.
TG_BOT=
TG_CHAT=

# All outbound fetches (Stockbit, IDX, Yahoo) go through this proxy.
# idx.co.id rejects datacenter IPs outright, so an Indonesian egress is needed:
#   http://10.10.1.54:8080  or  socks5h://10.10.1.54:1080
# Leave empty to use this host's own connection.
FETCH_PROXY=
